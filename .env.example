# Copy to .env (or .env.local) and fill in. NEVER commit the filled-in file.

# Public (safe for the browser): Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# SERVER ONLY - never expose to the client. Used by route handlers and scripts/seed-admin.ts.
SUPABASE_SERVICE_ROLE_KEY=

# Initial password for the admin account (username: mappCtech). Min 12 chars.
# Read ONLY by `npm run seed:admin`; remove it from the environment afterwards. The admin must
# change it at first login.
ADMIN_INITIAL_PASSWORD=
