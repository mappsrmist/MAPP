# Copy to .env.local and fill in. NEVER commit .env.local.

# Public (safe for the browser): Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# SERVER ONLY - never expose to the client. Used by route handlers and scripts/seed-admin.ts.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Initial password for the admin account (username: mappCtech). Min 8 chars.
# Read only by `npm run seed:admin` and the admin password-reset handler. Not stored in the repo.
ADMIN_INITIAL_PASSWORD=
